
# ==========================================
# PELUDITOS PET CHILE - EVALUACION 3
# Ejemplo de configuracion local
# ==========================================

# CONTRASENAS DE FLOWABLE Y POSTGRESQL
FLOWABLE_DB_PASSWORD=REEMPLAZAR_CON_CONTRASENA_SEGURA
FLOWABLE_ADMIN_PASSWORD=REEMPLAZAR_CON_CONTRASENA_SEGURA

# CONFIGURACION EXTERNAL WORKER
FLOWABLE_REST_URL=http://localhost:8080/flowable-rest
FLOWABLE_ADMIN_USER=rest-admin
WORKER_PORT=8081

# CONEXION WORKER -> BACKEND
PELUDITOS_BACKEND_URL=http://localhost:8082

# CONFIGURACION BACKEND
SERVER_PORT=8082

# BASE DE DATOS DEL NEGOCIO
PELUDITOS_DB_URL=jdbc:postgresql://localhost:5432/peluditos_db
PELUDITOS_DB_USER=flowable
PELUDITOS_DB_PASSWORD=REEMPLAZAR_CON_CONTRASENA_SEGURA

# IMPORTANTE:
# Este archivo solo contiene valores de ejemplo.
# No subir contrasenas reales a GitHub.
# Docker Compose lee el archivo .env local.
# Java ejecutado fuera de Docker requiere
# configurar estas variables en su entorno.
