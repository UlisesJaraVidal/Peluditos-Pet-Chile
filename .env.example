
# ==========================================
# PELUDITOS PET CHILE - EVALUACION 3
# CONFIGURACION DE EJEMPLO
# ==========================================

# FLOWABLE - BASE DE DATOS
FLOWABLE_DB_PASSWORD=REEMPLAZAR_CON_CONTRASENA_SEGURA

# FLOWABLE - ADMINISTRADOR
FLOWABLE_ADMIN_USER=rest-admin
FLOWABLE_ADMIN_PASSWORD=REEMPLAZAR_CON_CONTRASENA_SEGURA
FLOWABLE_REST_URL=http://localhost:8080/flowable-rest

# EXTERNAL WORKER
WORKER_PORT=8081
PELUDITOS_BACKEND_URL=http://localhost:8082

# BACKEND JAX-RS
SERVER_PORT=8082

# POSTGRESQL DEL NEGOCIO
PELUDITOS_DB_PORT=5433
PELUDITOS_DB_URL=jdbc:postgresql://localhost:5433/peluditos_db
PELUDITOS_DB_USER=flowable
PELUDITOS_DB_PASSWORD=REEMPLAZAR_CON_CONTRASENA_SEGURA

# FRONTEND - ORIGENES PERMITIDOS
FLOWABLE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000,http://localhost:5500

# ==========================================
# INSTRUCCIONES DE SEGURIDAD
# ==========================================

# Este archivo contiene valores de ejemplo.
# No publicar contrasenas reales en GitHub.
#
# Para Docker:
# Copiar como .env y establecer credenciales nuevas.
#
# Para Backend y Worker ejecutados fuera de Docker:
# Configurar variables de entorno en Windows.
#
# No ejecutar servicios usando las contrasenas
# de ejemplo.
