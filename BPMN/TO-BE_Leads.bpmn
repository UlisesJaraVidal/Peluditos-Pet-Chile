<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:flowable="http://flowable.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://flowable.org/test">
  <process id="to_be_leads" name="TO-BE Leads" isExecutable="true">
    <startEvent id="startnoneevent1" name="Lead recibido" />
    <userTask id="FormTask_1" name="Registrar datos del lead." />
    <userTask id="FormTask_3" name="Responder consulta/cotizar." />
    <exclusiveGateway id="Exclusive_Databased_Gateway_5" name="¿Cliente quiere comprar?" />
    <userTask id="FormTask_7" name="Coordinar pedido." />
    
    <!-- Tarea del External Worker configurada correctamente -->
    <serviceTask id="ServiceTask_11" name="Convertir en cliente" flowable:type="external" flowable:topic="registrarLeadTopic" />
    
    <serviceTask id="ServiceTask_13" name="Activar Oportunidad comercial." flowable:expression="${true}" />
    <userTask id="FormTask_9" name="Registrar lead en pausa/perdido." />
    <endEvent id="EndNoneEvent_17" name="Lead convertido." />
    <endEvent id="EndNoneEvent_19" name="Fin de consulta." />
    
    <!-- Conexiones del proceso -->
    <sequenceFlow id="SequenceFlow_2" sourceRef="startnoneevent1" targetRef="FormTask_1" />
    <sequenceFlow id="SequenceFlow_4" sourceRef="FormTask_1" targetRef="FormTask_3" />
    <sequenceFlow id="SequenceFlow_6" sourceRef="FormTask_3" targetRef="Exclusive_Databased_Gateway_5" />
    <sequenceFlow id="SequenceFlow_8" name="SI" sourceRef="Exclusive_Databased_Gateway_5" targetRef="FormTask_7">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${quiereComprar == true}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_12" sourceRef="FormTask_7" targetRef="ServiceTask_11" />
    <sequenceFlow id="SequenceFlow_14" sourceRef="ServiceTask_11" targetRef="ServiceTask_13" />
    <sequenceFlow id="SequenceFlow_18" sourceRef="ServiceTask_13" targetRef="EndNoneEvent_17" />
    <sequenceFlow id="SequenceFlow_10" name="NO" sourceRef="Exclusive_Databased_Gateway_5" targetRef="FormTask_9">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${quiereComprar == false}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_20" sourceRef="FormTask_9" targetRef="EndNoneEvent_19" />
  </process>
</definitions>