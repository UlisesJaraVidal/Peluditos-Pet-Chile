    <serviceTask id="ServiceTask_3" name="Buscar clientes con fechas proximas." flowable:expression="${true}">
      <extensionElements>
        <design:stencilid><![CDATA[ServiceTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </serviceTask>
    <userTask id="FormTask_5" name="Revisar lista y preparar campaña." flowable:assignee="${initiator}" flowable:formFieldValidation="false">
