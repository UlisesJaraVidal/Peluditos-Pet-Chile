      </extensionElements>
      <timerEventDefinition>
        <timeCycle>R/PT24H</timeCycle>
      </timerEventDefinition>
    </startEvent>
    <endEvent id="EndNoneEvent_9" name="Campaña finalizada.">
      <extensionElements>
